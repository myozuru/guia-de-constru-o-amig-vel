  "components": [
    {
      "name": "Mystic Primary Button",
      "kind": "button",
      "refersTo": "button-mystic",
      "description": "Default high-emphasis action with the existing violet gradient and glow.",
      "html": "<button class=\"ds-btn-mystic\">Realizar teste</button>",
      "css": ".ds-btn-mystic{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:8px 16px;border:1px solid hsl(var(--primary)/.4);border-radius:8px;background:var(--gradient-mystic);color:hsl(var(--primary-foreground));font:600 14px 'Cormorant Garamond',Georgia,serif;letter-spacing:.025em;box-shadow:0 0 22px -4px hsl(var(--primary)/.55);transition:box-shadow 200ms cubic-bezier(.22,1,.36,1),transform 200ms cubic-bezier(.22,1,.36,1);cursor:pointer}.ds-btn-mystic:hover{box-shadow:0 0 32px -2px hsl(var(--primary)/.85);transform:translateY(-1px)}.ds-btn-mystic:focus-visible{outline:2px solid hsl(var(--ring));outline-offset:2px}"
    },
    {
      "name": "Gold Confirmation Button",
      "kind": "button",
      "refersTo": "button-gold",
      "description": "Gold-gradient action for important confirmation and completion.",
      "html": "<button class=\"ds-btn-gold\">Confirmar</button>",
      "css": ".ds-btn-gold{display:inline-flex;align-items:center;justify-content:center;height:40px;padding:8px 16px;border:1px solid hsl(var(--accent)/.5);border-radius:8px;background:var(--gradient-gold);color:hsl(var(--accent-foreground));font:600 14px 'Cormorant Garamond',Georgia,serif;box-shadow:0 0 18px -4px hsl(var(--accent)/.55);transition:box-shadow 200ms ease,transform 200ms ease;cursor:pointer}.ds-btn-gold:hover{box-shadow:0 0 28px -2px hsl(var(--accent)/.8);transform:translateY(-1px)}.ds-btn-gold:focus-visible{outline:2px solid hsl(var(--ring));outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Dark field with a violet border and glow on focus.",
      "html": "<input class=\"ds-input\" type=\"text\" placeholder=\"Nome do personagem\" />",
      "css": ".ds-input{width:100%;height:40px;padding:8px 12px;border:1px solid hsl(var(--border));border-radius:8px;background:hsl(var(--background)/.6);color:hsl(var(--foreground));font:400 16px 'Cormorant Garamond',Georgia,serif;transition:border-color 160ms ease,box-shadow 160ms ease}.ds-input::placeholder{color:hsl(var(--muted-foreground)/.7)}.ds-input:focus-visible{outline:2px solid hsl(var(--primary)/.6);outline-offset:2px;border-color:hsl(var(--primary)/.6);box-shadow:0 0 18px -4px hsl(var(--primary)/.45)}.ds-input:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Enigmatic Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Shared dark panel with a deep shadow and a fine inset highlight.",
      "html": "<article class=\"ds-card\"><h3>Ficha</h3><p>Resumo da personagem</p></article>",
      "css": ".ds-card{padding:24px;border:1px solid hsl(var(--border));border-radius:10px;background:linear-gradient(145deg,hsl(265 25% 10%),hsl(270 28% 7%));color:hsl(var(--card-foreground));box-shadow:var(--shadow-occult),inset 0 1px 0 hsl(268 30% 22%/.3)}.ds-card h3{margin:0 0 8px;color:hsl(var(--foreground));font:700 20px 'Cinzel',serif;letter-spacing:.06em}.ds-card p{margin:0;color:hsl(var(--muted-foreground));font:500 16px 'Cormorant Garamond',Georgia,serif}"
    },
    {
      "name": "Mystic Badge",
      "kind": "chip",
      "refersTo": "badge-mystic",
      "description": "Compact pill for a selected or emphasized status.",
      "html": "<span class=\"ds-badge-mystic\">Ativo</span>",
      "css": ".ds-badge-mystic{display:inline-flex;align-items:center;min-height:22px;padding:2px 10px;border:1px solid hsl(var(--primary)/.4);border-radius:999px;background:hsl(var(--primary)/.15);color:hsl(var(--primary));font:600 13px 'Cormorant Garamond',Georgia,serif;transition:background-color 160ms ease,box-shadow 160ms ease}.ds-badge-mystic:hover{background:hsl(var(--primary)/.22);box-shadow:0 0 10px -2px hsl(var(--primary)/.4)}"
    },
    {
      "name": "Active Module Tab",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Selected tab in the fixed, horizontally scrollable module bar.",
      "html": "<button class=\"ds-nav-active\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3v18M3 12h18\"/></svg>Fichas</button>",
      "css": ".ds-nav-active{position:relative;display:inline-flex;align-items:center;gap:6px;height:36px;padding:4px 12px;border:1px solid hsl(var(--primary)/.5);border-radius:8px;background:hsl(var(--primary)/.15);color:hsl(var(--primary));box-shadow:0 0 16px -5px hsl(var(--primary)/.8);font:600 13px 'Cinzel',serif;letter-spacing:.06em;white-space:nowrap}.ds-nav-active svg{width:14px;height:14px;fill:none;stroke:hsl(var(--accent));stroke-width:2;stroke-linecap:round}.ds-nav-active::after{position:absolute;right:8px;bottom:-1px;left:8px;height:1px;background:hsl(var(--accent));content:''}.ds-nav-active:focus-visible{outline:2px solid hsl(var(--ring));outline-offset:2px}"
    },
    {
      "name": "Module Header",
      "kind": "custom",
